{
  "scope": "community",
  "name": "google-search-console",
  "version": "1.0.0",
  "description": "Commands to interact with Google Search Console using the Search Console API",
  "license": "MIT",
  "tags": [
    "google",
    "search-console",
    "seo",
    "webmasters",
    "search",
    "cli"
  ],
  "dependencies": [
    "community/google-auth"
  ],
  "system": [
    [
      "test:gws --version",
      "brew:googleworkspace-cli",
      "npm:@googleworkspace/cli"
    ],
    [
      "test:jq --version",
      "brew:jq",
      "linux:jq"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:google"
          ],
          "help": {
            "text": "Google commands"
          }
        }
      ]
    },
    {
      "name": "google",
      "commands": [
        {
          "name": "search-console",
          "execute": [
            "profile:google:search-console"
          ],
          "help": {
            "text": "Google Search Console commands"
          }
        }
      ]
    },
    {
      "name": "google:search-console",
      "commands": [
        {
          "name": "services",
          "private": true,
          "execute": [
            "echo '{\"name\":\"search-console\",\"scope\":\"https://www.googleapis.com/auth/webmasters.readonly\",\"description\":\"Access Google Search Console data\"}'"
          ],
          "help": {
            "text": "Output service metadata for auth resolution"
          }
        },
        {
          "name": "query",
          "execute": [
            "${packageDir}/lib/query.sh values(siteUrl, startDate, endDate, dimensions, searchType, rowLimit, startRow)"
          ],
          "help": {
            "text": "Query search analytics data (clicks, impressions, CTR, position)",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              },
              {
                "name": "startDate",
                "text": "Start date in YYYY-MM-DD format"
              },
              {
                "name": "endDate",
                "text": "End date in YYYY-MM-DD format"
              },
              {
                "name": "dimensions",
                "text": "Comma-separated dimensions: query, page, country, device, searchAppearance, date",
                "default": ""
              },
              {
                "name": "searchType",
                "text": "Search type filter",
                "default": "web",
                "options": [
                  "web",
                  "image",
                  "video",
                  "news",
                  "discover",
                  "googleNews"
                ]
              },
              {
                "name": "rowLimit",
                "text": "Maximum number of rows to return (max 25000)",
                "default": "1000"
              },
              {
                "name": "startRow",
                "text": "Zero-based start row for pagination",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "inspect",
          "execute": [
            "${packageDir}/lib/inspect.sh values(inspectionUrl, siteUrl)"
          ],
          "help": {
            "text": "Inspect a URL's index status and crawl information",
            "variables": [
              {
                "name": "inspectionUrl",
                "text": "URL to inspect (must be under the specified site)",
                "arg": true
              },
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected."
              }
            ]
          }
        },
        {
          "name": "sites",
          "execute": [
            "profile:google:search-console:sites"
          ],
          "help": {
            "text": "Manage verified sites"
          }
        },
        {
          "name": "sitemaps",
          "execute": [
            "profile:google:search-console:sitemaps"
          ],
          "help": {
            "text": "Manage sitemaps"
          }
        }
      ]
    },
    {
      "name": "google:search-console:sites",
      "commands": [
        {
          "name": "list",
          "execute": [
            "${packageDir}/lib/gapi.sh GET https://searchconsole.googleapis.com/webmasters/v3/sites"
          ],
          "help": {
            "text": "List all verified sites in Search Console"
          }
        },
        {
          "name": "get",
          "execute": [
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh GET 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}'"
          ],
          "help": {
            "text": "Get information about a specific site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "add",
          "execute": [
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh PUT 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}'"
          ],
          "help": {
            "text": "Add a site to Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain to add (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to remove this site from Search Console?",
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh DELETE 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}'"
          ],
          "help": {
            "text": "Remove a site from Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain to remove (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "google:search-console:sitemaps",
      "commands": [
        {
          "name": "list",
          "execute": [
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh GET 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}/sitemaps'"
          ],
          "help": {
            "text": "List sitemaps for a site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "set:encodedFeed=!echo -n 'value(feedpath)' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh GET 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}/sitemaps/${encodedFeed}'"
          ],
          "help": {
            "text": "Get information about a specific sitemap",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL (e.g. https://example.com/sitemap.xml)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "submit",
          "execute": [
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "set:encodedFeed=!echo -n 'value(feedpath)' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh PUT 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}/sitemaps/${encodedFeed}'"
          ],
          "help": {
            "text": "Submit a sitemap for a site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL to submit (e.g. https://example.com/sitemap.xml)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to delete this sitemap?",
            "set:resolvedSite=!echo ${siteUrl} | grep -qE '^(https?://|sc-domain:)' && echo ${siteUrl} || echo sc-domain:${siteUrl}",
            "set:encodedUrl=!echo -n '${resolvedSite}' | jq -Rr @uri",
            "set:encodedFeed=!echo -n 'value(feedpath)' | jq -Rr @uri",
            "${packageDir}/lib/gapi.sh DELETE 'https://searchconsole.googleapis.com/webmasters/v3/sites/${encodedUrl}/sitemaps/${encodedFeed}'"
          ],
          "help": {
            "text": "Delete a sitemap from Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com) or URL-prefix property (e.g. https://example.com). Domain properties are auto-detected.",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL to delete (e.g. https://example.com/sitemap.xml)",
                "arg": true
              }
            ]
          }
        }
      ]
    }
  ]
}
