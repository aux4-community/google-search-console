{
  "scope": "community",
  "name": "google-search-console",
  "version": "1.2.0",
  "description": "Commands to interact with Google Search Console using the Search Console API",
  "license": "MIT",
  "tags": [
    "google",
    "search-console",
    "seo",
    "webmasters",
    "search",
    "cli"
  ],
  "dependencies": [
    "community/google-auth",
    "aux4/curl"
  ],
  "system": [
    [
      "test:jq --version",
      "brew:jq",
      "linux:jq"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:google"
          ],
          "help": {
            "text": "Google commands"
          }
        }
      ]
    },
    {
      "name": "google",
      "commands": [
        {
          "name": "search-console",
          "execute": [
            "profile:google:search-console"
          ],
          "help": {
            "text": "Google Search Console commands"
          }
        }
      ]
    },
    {
      "name": "google:search-console",
      "commands": [
        {
          "name": "services",
          "private": true,
          "execute": [
            "echo '{\"name\":\"search-console\",\"scope\":\"https://www.googleapis.com/auth/webmasters https://www.googleapis.com/auth/indexing\",\"readonlyScope\":\"https://www.googleapis.com/auth/webmasters.readonly\",\"description\":\"Access Google Search Console data and Indexing API\"}'"
          ],
          "help": {
            "text": "Output service metadata for auth resolution"
          }
        },
        {
          "name": "query",
          "execute": [
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:dimensionList=!DIMENSIONS=value(dimensions) jq -rn 'env.DIMENSIONS | split(\",\") | map(select(. != \"\")) | if length == 0 then \"\" else tojson end'",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}/searchAnalytics/query",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method POST --header 'Content-Type: application/json' --url value(requestUrl) --body 'object(startDate, endDate, searchType:type, rowLimit, startRow, dimensionList:dimensions)'"
          ],
          "help": {
            "text": "Query search analytics data (clicks, impressions, CTR, position)",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "startDate",
                "text": "Start date in YYYY-MM-DD format"
              },
              {
                "name": "endDate",
                "text": "End date in YYYY-MM-DD format"
              },
              {
                "name": "dimensions",
                "text": "Comma-separated dimensions: query, page, country, device, searchAppearance, date",
                "default": ""
              },
              {
                "name": "searchType",
                "text": "Search type filter",
                "default": "web",
                "options": [
                  "web",
                  "image",
                  "video",
                  "news",
                  "discover",
                  "googleNews"
                ]
              },
              {
                "name": "rowLimit",
                "text": "Maximum number of rows to return (max 25000)",
                "default": "1000",
                "type": "number"
              },
              {
                "name": "startRow",
                "text": "Zero-based start row for pagination",
                "default": "0",
                "type": "number"
              },
              {
                "name": "dimensionList",
                "text": "Dimensions as a JSON array, derived from --dimensions",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "inspect",
          "execute": [
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:apiPath=/v1/urlInspection/index:inspect",
            "set:requestUrl=${apiUrl}${apiPath}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method POST --header 'Content-Type: application/json' --url value(requestUrl) --body 'object(inspectionUrl, site.resolved:siteUrl)'"
          ],
          "help": {
            "text": "Inspect a URL's index status and crawl information",
            "variables": [
              {
                "name": "inspectionUrl",
                "text": "URL to inspect (must be under the specified site)",
                "arg": true
              },
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)"
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "index",
          "execute": [
            "set:apiPath=/v3/urlNotifications:publish",
            "set:requestUrl=${indexingApiUrl}${apiPath}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method POST --header 'Content-Type: application/json' --url value(requestUrl) --body 'object(url, type)'"
          ],
          "help": {
            "text": "Request Google to index or re-index a URL via the Indexing API",
            "variables": [
              {
                "name": "url",
                "text": "Full URL to index (e.g. https://example.com/page)",
                "arg": true
              },
              {
                "name": "type",
                "text": "Notification type (URL_UPDATED or URL_DELETED)",
                "default": "URL_UPDATED"
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "indexingApiUrl",
                "text": "Indexing API base URL",
                "default": "https://indexing.googleapis.com",
                "env": "GOOGLE_INDEXING_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "sites",
          "execute": [
            "profile:google:search-console:sites"
          ],
          "help": {
            "text": "Manage verified sites"
          }
        },
        {
          "name": "sitemaps",
          "execute": [
            "profile:google:search-console:sitemaps"
          ],
          "help": {
            "text": "Manage sitemaps"
          }
        }
      ]
    },
    {
      "name": "google:search-console:sites",
      "commands": [
        {
          "name": "list",
          "execute": [
            "set:apiPath=/webmasters/v3/sites",
            "set:requestUrl=${apiUrl}${apiPath}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "List all verified sites in Search Console",
            "variables": [
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "Get information about a specific site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "add",
          "execute": [
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method PUT --url value(requestUrl)"
          ],
          "help": {
            "text": "Add a site to Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain to add (e.g. example.com)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to remove this site from Search Console?",
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method DELETE --url value(requestUrl)"
          ],
          "help": {
            "text": "Remove a site from Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain to remove (e.g. example.com)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "google:search-console:sitemaps",
      "commands": [
        {
          "name": "list",
          "execute": [
            "set:site=!SITE=value(siteUrl) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}/sitemaps",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "List sitemaps for a site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "set:site=!SITE=value(siteUrl) FEED=value(feedpath) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri, feed: (env.FEED | @uri)}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}/sitemaps/${site.feed}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "Get information about a specific sitemap",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL (e.g. https://example.com/sitemap.xml)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "submit",
          "execute": [
            "set:site=!SITE=value(siteUrl) FEED=value(feedpath) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri, feed: (env.FEED | @uri)}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}/sitemaps/${site.feed}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method PUT --url value(requestUrl)"
          ],
          "help": {
            "text": "Submit a sitemap for a site",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL to submit (e.g. https://example.com/sitemap.xml)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to delete this sitemap?",
            "set:site=!SITE=value(siteUrl) FEED=value(feedpath) jq -cn 'env.SITE | (if test(\"^(https?://|sc-domain:)\") then . else \"sc-domain:\" + . end) | {resolved: ., encoded: @uri, feed: (env.FEED | @uri)}'",
            "set:site=json:${site}",
            "set:requestUrl=${apiUrl}/webmasters/v3/sites/${site.encoded}/sitemaps/${site.feed}",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method DELETE --url value(requestUrl)"
          ],
          "help": {
            "text": "Delete a sitemap from Search Console",
            "variables": [
              {
                "name": "siteUrl",
                "text": "Site domain (e.g. example.com)",
                "arg": true
              },
              {
                "name": "feedpath",
                "text": "Sitemap URL to delete (e.g. https://example.com/sitemap.xml)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Search Console API base URL",
                "default": "https://searchconsole.googleapis.com",
                "env": "SEARCH_CONSOLE_API_URL",
                "private": true
              }
            ]
          }
        }
      ]
    }
  ]
}
